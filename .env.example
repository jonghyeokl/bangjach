APP_NAME="방자취 API"
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./bangjach.db
# 운영 환경은 PostgreSQL 필수. 비밀번호의 특수문자는 URL 인코딩한다.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bangjach
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
# python -c 'import secrets; print(secrets.token_urlsafe(48))' 로 생성한다.
# 운영은 최소 32자 필수. 개발에서 비우면 재시작 시 모든 로그인이 만료된다.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ADMIN_USER_IDS=[]
RATE_LIMIT_ENABLED=true
# /chat/completions 및 JSON response_format을 지원하는 공급자 설정.
# 세 항목을 모두 설정해야 실제 분석을 호출한다. 미설정은 FAILED로 기록한다.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=10
