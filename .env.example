APP_NAME="방자취 API"
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./data/bangjach.db
# 백엔드 repo 안의 실제 SQLite DB. 별도 DB 서버·복원 과정이 필요 없다.
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
# python -c 'import secrets; print(secrets.token_urlsafe(48))' 로 생성한다.
# 운영은 최소 32자 필수. 개발에서 비우면 재시작 시 모든 로그인이 만료된다.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ADMIN_USER_IDS=[]
RATE_LIMIT_ENABLED=true
# OpenAI Platform에서 API 키 발급. ChatGPT 로그인 정보가 아닌 별도 API 키.
# 미설정/오류여도 리뷰는 저장하고 분석 상태는 FAILED로 기록한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=10

# 로컬 사진은 repo 안의 data/photos에 저장한다.
REVIEW_PHOTO_BUCKET=
REVIEW_PHOTO_LOCAL_DIR=data/photos
